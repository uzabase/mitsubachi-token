# tools/.env にコピーして値を入れる。tools/.env はコミットされない。
# 値の入手先は docs/contributing.md「Figma ファイルと認証情報」を参照。

# Figma の Personal access token（Settings > Personal access tokens）
FIGMA_TOKEN=

# Figma ファイルの URL https://www.figma.com/file/<この部分>/ の文字列
PRIMITIVE_FIGMA_DESIGN_FILE_KEY=
SEMANTIC_FIGMA_DESIGN_FILE_KEY=
